# Server-only values. Set these in Render; never prefix them with VITE_.
APP_URL="http://localhost:3000"
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SESSION_SECRET="generate-a-long-random-32-byte-or-longer-secret"

# Razorpay server-only values. Use test-mode credentials while implementing and
# testing purchases. Never expose these in browser/mobile variables or commit
# actual values to this file.
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="razorpay_test_secret_..."
# Set this once the signed webhook endpoint is deployed in Step 4.
RAZORPAY_WEBHOOK_SECRET="a-long-random-webhook-secret"

# Comma-separated exact browser origins in addition to APP_URL. Do not use *.
CORS_ALLOWED_ORIGINS="http://localhost:5173"

# Browser-only Vite values. These may contain the publishable key, never a
# service-role/secret key.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
